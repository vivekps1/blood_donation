# Blood Donation Management System — server configuration.
# Copy to .env and fill in real values. Never commit the filled-in file.

# --- Core -------------------------------------------------------------------
PORT=8000
# MongoDB connection string.
DB=mongodb://localhost:27017/blood_donation
# Secret used to sign JWTs. Use a long random string; changing it signs everyone out.
JWT_SEC=change-me-to-a-long-random-string

# Legacy AES key. Only still needed while accounts created before the scrypt migration
# have not yet signed in — their passwords are re-hashed automatically on next login.
# Once every account has signed in once, this can be removed.
PASS=legacy-aes-key

# --- Deployment -------------------------------------------------------------
NODE_ENV=development
# Comma-separated origins allowed to call the API. Enforced when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Set true when running behind a reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=false
# Base URL of the frontend, used to build referral/invitation links.
APP_URL=http://localhost:5173
# Set true to disable the scheduled eligibility sweep and inventory expiry jobs.
DISABLE_JOBS=false

# --- Email (nodemailer) -----------------------------------------------------
# Used for verification codes, password resets and notifications. Leaving SMTP_HOST unset
# disables email; the app still works and records the notification in-app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@blooddonation.local
# Leave false only for local testing against a self-signed certificate.
SMTP_REJECT_UNAUTHORIZED=true

# --- SMS (Twilio, optional) -------------------------------------------------
# Without these, SMS is simulated and logged to the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
